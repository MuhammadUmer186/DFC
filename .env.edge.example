# Copy to .env.edge and fill REAL values before:
#   docker compose -f docker-compose.edge.yml --env-file .env.edge up -d
# Never commit .env.edge (it is gitignored).

# ---- database ----
MSSQL_SA_PASSWORD=Change_This_Strong_Pass1

# ---- JWT (legacy HS256 — keep identical to the Cloud during migration) ----
JWT_ISSUER=DFC-RMS
JWT_AUDIENCE=DFC-RMS-Clients
JWT_TOKEN=Change_This_To_A_Long_Random_Secret_Key

# ---- first SuperAdmin (one-time bootstrap; becomes a DB user on first login) ----
SUPERADMIN_USERNAME=HassanAli
SUPERADMIN_PASSWORD=Change_This_Password

# ---- node identity (Phase 1) ----
# Leave NODE_ID blank on first boot; the API generates + persists one to the
# edge-keys volume and logs it. Copy it back here so it never changes.
DEPLOYMENT_NODE_ID=
# BRANCH_ID must MATCH the Cloud node's branch. Get it from the Cloud logs /
# /api/system/node-status and paste here.
DEPLOYMENT_BRANCH_ID=
DEPLOYMENT_BRANCH_NAME=Main Branch
DEPLOYMENT_BRANCH_CODE=DFC
DEPLOYMENT_CLOUD_BASE_URL=https://dfcfront.aiotstudio.online
DEPLOYMENT_EDGE_BASE_URL=https://edge.dfc.lan

# ---- sync engine (Phase 5) — MUST be identical on Cloud and Edge ----
SYNC_HMAC_SECRET=
SYNC_INTERVAL_SECONDS=10

# ---- offline auth (Phase 8) — optional RS256; blank = keep HS256 ----
AUTH_ISSUER=DFC-RMS-edge
AUTH_PRIVATE_KEY_PATH=/app/keys/jwt-edge-private.pem
AUTH_TRUSTED_PUBLICKEY_CLOUD=/app/keys/jwt-cloud-public.pem
AUTH_TRUSTED_PUBLICKEY_EDGE=/app/keys/jwt-edge-public.pem

# ---- TLS + PWA runtime config for the gateway ----
EDGE_TLS_CERT_DIR=./deploy/edge/certs                # holds edge.crt + edge.key
EDGE_RUNTIME_CONFIG=./deploy/edge/runtime-config.json

# ---- backup sidecar (Phase 16) ----
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_MINUTES=30
BACKUP_EXTERNAL_MOUNT=/mnt/backup-drive              # external drive mount on the host
BACKUP_EXTERNAL_DIR=/external/dfc-edge               # dir under that mount
BACKUP_GPG_RECIPIENT=                                # e.g. ops@yourco — enables encrypted off-machine copies

# ---- AI (edge defaults to the mock provider — no external calls / cost) ----
AI_USE_MOCK_PROVIDER=true
OPENAI_API_KEY=
