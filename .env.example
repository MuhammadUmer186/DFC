# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# SQL Server sa password — must be 8+ chars with at least 3 of:
# uppercase, lowercase, digit, symbol.
MSSQL_SA_PASSWORD=Change_This_Strong_Pass1

# JWT signing settings (must match between issuance and validation —
# changing these invalidates all existing login tokens)
JWT_ISSUER=DFC-RMS
JWT_AUDIENCE=DFC-RMS-Clients
JWT_TOKEN=Change_This_To_A_Long_Random_Secret_Key

# First SuperAdmin account seeded on startup
SUPERADMIN_USERNAME=HassanAli
SUPERADMIN_PASSWORD=Change_This_Password

# AI features — OpenAI API key. Leave blank to run with the built-in Mock provider (no cost,
# no external calls, deterministic placeholder answers) instead of a real model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Per-feature kill switches — set any to false to disable that AI capability without a redeploy.
AI_FORECASTING_ENABLED=true
AI_INVENTORY_ENABLED=true
AI_ASSISTANT_ENABLED=true

# Force the Mock provider even if OPENAI_API_KEY is set — useful for staging/CI.
AI_USE_MOCK_PROVIDER=false

# ============================================================================
# Offline-first / cloud-sync — Phase 1: node & branch identity
# ============================================================================
# These map to the "Deployment" config section (Deployment__NodeId, etc.).
# Leave NODE_ID / BRANCH_ID blank on first boot: the API generates a GUID,
# persists it to the mounted keys volume, and logs it. Copy the logged values
# back here (and onto every other node of the SAME branch for BRANCH_ID) so the
# identity is pinned and never changes on restart.

# "Cloud" for the Hostinger/Dokploy deployment, "Edge" for the in-restaurant box.
DEPLOYMENT_NODE_ROLE=Cloud

# Stable GUIDs — fill after first boot (see logs) or pre-generate with a UUID tool.
DEPLOYMENT_NODE_ID=
DEPLOYMENT_BRANCH_ID=

# Human labels (used only when the Branch/Node rows are first created).
DEPLOYMENT_BRANCH_NAME=Main Branch
DEPLOYMENT_BRANCH_CODE=
DEPLOYMENT_NODE_DISPLAY_NAME=

# Peer URLs — used by the sync worker/endpoints from Phase 5 onward.
DEPLOYMENT_CLOUD_BASE_URL=https://dfcfront.aiotstudio.online
DEPLOYMENT_EDGE_BASE_URL=

# ---- Phase 8: offline authentication ----
# Optional RS256 per-node JWT signing. Leave blank to keep the legacy HS256
# shared secret (JWT_TOKEN above) — fully backward compatible.
#   Auth__Issuer        e.g. DFC-RMS-cloud  /  DFC-RMS-edge
#   Auth__PrivateKeyPath  PEM, MOUNTED SECRET, never committed (e.g. /app/keys/jwt-private.pem)
#   Auth__TrustedPublicKeys__cloud / __edge  PEM public keys of BOTH issuers, so a
#     token minted on either node is accepted on both.
AUTH_ISSUER=
AUTH_PRIVATE_KEY_PATH=
AUTH_TRUSTED_PUBLICKEY_CLOUD=
AUTH_TRUSTED_PUBLICKEY_EDGE=
# The config SuperAdmin (SUPERADMIN_USERNAME/PASSWORD) is now a ONE-TIME bootstrap:
# it seeds a database SuperAdmin on first login, then the config path is disabled.

# ---- Phase 5: transactional sync engine ----
# Shared HMAC-SHA256 secret for the edge<->cloud sync channel. Must be IDENTICAL
# on both nodes. Generate a long random value (e.g. `openssl rand -base64 48`).
SYNC_HMAC_SECRET=
# Leave blank to auto-decide (worker ON for Edge, OFF for Cloud), or "true"/"false".
SYNC_WORKER_ENABLED=
SYNC_INTERVAL_SECONDS=10

# ---- Phase 14: controlled migrations ----
# The `migrator` one-shot service applies EF migrations once, before the API
# starts. Take a BACKUP DATABASE checkpoint first (writes to the mssql-backups
# volume, server-side path below). Set false only if Phase 16 backups fully cover you.
MIGRATOR_BACKUP_BEFORE_MIGRATE=true
MIGRATOR_BACKUP_PATH=/var/opt/mssql/backup
